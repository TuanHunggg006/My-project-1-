+    private IEnumerator ResolvePlacement()
+    {
+        while (activePlacementAnimations > 0)
+            yield return null;
+        ClearCompletedRowsAndColumns();
+        while (activeClearAnimations > 0)
+            yield return null;
+        resolutionCoroutine = null;
+    }
