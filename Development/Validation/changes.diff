+    private IEnumerator PlayLineGlow(Image halo, Image core, Image sweep,
+        Vector3 first, Vector3 last, int lineLength)
+    {
+        float elapsed = 0f;
+        float duration = Mathf.Max(0.01f, lineFlashDuration + clearDuration +
+            Mathf.Max(0f, (lineLength - 1) / 2f - 0.5f) * clearStagger);
+        while (halo != null && core != null && sweep != null && elapsed < duration)
+        {
+            elapsed += Time.unscaledDeltaTime;
+            float t = Mathf.Clamp01(elapsed / duration);
+            float flash = Mathf.Clamp01(elapsed / 0.055f) * (1f - t);
+            Color color = lineGlowColor;
+            color.a *= flash;
+            halo.color = color;
+            core.color = new Color(1f, 1f, 1f, flash);
+            sweep.color = new Color(1f, 1f, 1f, Mathf.Sin(t * Mathf.PI));
+            sweep.rectTransform.position = Vector3.Lerp(first, last, Mathf.SmoothStep(0f, 1f, t));
+            yield return null;
+        }
+        Image[] images = { halo, core, sweep };
+        foreach (Image image in images)
+            if (image != null)
+            {
+                glowVisuals.Remove(image.rectTransform);
+                Destroy(image.gameObject);
+            }
+        activeClearAnimations = Mathf.Max(0, activeClearAnimations - 1);
